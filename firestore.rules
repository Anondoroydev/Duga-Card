rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic ID validation
    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Card entity validation
    function isValidCard(data) {
      return data.keys().hasAll(['from', 'to', 'message', 'createdAt']) &&
             data.keys().hasOnly(['from', 'to', 'message', 'theme', 'imageUrl', 'createdAt']) &&
             data.from is string && data.from.size() <= 100 &&
             data.to is string && data.to.size() <= 100 &&
             data.message is string && data.message.size() <= 2000 &&
             (data.theme == null || data.theme is string) &&
             (data.imageUrl == null || data.imageUrl is string);
    }

    match /cards/{cardId} {
      // Publicly readable cards for sharing
      allow get: if isValidId(cardId);
      
      // Publicly creatable cards (no auth required for this specific app's greeting flow)
      allow create: if isValidId(cardId) && isValidCard(request.resource.data);
    }
  }
}
